{
  "manifest_version": 3,
  "name": "Research Brain",
  "version": "0.1.0",
  "description": "Your second brain for research sessions",
  "permissions": ["storage"],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Research Brain"
  },
  "background": {
    "service_worker": "service-worker.js",
    "type": "module"
  },
  "icons": {
    "16": "icons/icon-16.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  }
}
